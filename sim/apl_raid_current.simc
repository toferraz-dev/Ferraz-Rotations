actions.precombat=snapshot_stats
actions.precombat+=/moonkin_form
actions.precombat+=/wrath
actions=call_action_list,name=trinkets
actions+=/run_action_list,name=opener_aoe,if=(cooldown.ca_inc.up&!buff.ca_inc.up)&spell_targets>1
actions+=/run_action_list,name=opener_st,if=(cooldown.ca_inc.up&!buff.ca_inc.up)&spell_targets=1
actions+=/run_action_list,name=aoe,if=spell_targets>1
actions+=/run_action_list,name=st
actions.trinkets=use_items,if=(buff.ca_inc.up|cooldown.ca_inc.remains>40)
actions.st=moonfire,if=(dot.moonfire.remains<2|dot.moonfire.refreshable&buff.eclipse.down)
actions.st+=/sunfire,if=(dot.sunfire.remains<2|dot.sunfire.refreshable&buff.eclipse.down)
actions.st+=/eclipse,if=buff.eclipse.down
actions.st+=/fury_of_elune,if=(!talent.sundered_firmament|(debuff.atmospheric_exposure.remains<2&buff.eclipse_lunar.remains>5)|fight_remains<20)
actions.st+=/starfall,if=spell_targets>=2&buff.touch_the_cosmos.react
actions.st+=/starsurge,if=buff.touch_the_cosmos.react
actions.st+=/starsurge,if=(buff.eclipse.up&astral_power>=50|buff.eclipse.down&astral_power.deficit<20)
actions.st+=/celestial_alignment,if=!buff.ca_inc.up&buff.ascendant_stars.down
actions.st+=/wrath,if=buff.eclipse.down
actions.st+=/starfire
actions.aoe=sunfire,if=(dot.sunfire.remains<2|dot.sunfire.refreshable&buff.eclipse.down)
actions.aoe+=/moonfire,if=spell_targets<99&(dot.moonfire.remains<2|dot.moonfire.refreshable&buff.eclipse.down)
actions.aoe+=/eclipse,if=buff.eclipse.down
actions.aoe+=/fury_of_elune,if=(!talent.sundered_firmament|debuff.atmospheric_exposure.remains<2)
actions.aoe+=/celestial_alignment,if=!buff.ca_inc.up&(buff.eclipse.down|fight_remains<20)
actions.aoe+=/starfall,if=buff.touch_the_cosmos.react
actions.aoe+=/starfall,if=astral_power>50&target.time_to_die>5
actions.aoe+=/starsurge,if=buff.starfall.up&buff.touch_the_cosmos.react
actions.aoe+=/starsurge,if=buff.starfall.up&astral_power>80&buff.starlord.stack<3
actions.aoe+=/starfire
actions.opener_st=moonfire,if=(dot.moonfire.remains<2|dot.moonfire.refreshable&buff.eclipse.down)
actions.opener_st+=/sunfire,if=(dot.sunfire.remains<2|dot.sunfire.refreshable&buff.eclipse.down)
actions.opener_st+=/eclipse,if=buff.eclipse.down
actions.opener_st+=/starsurge,if=(buff.ascendant_stars.up|buff.touch_the_cosmos.react)
actions.opener_st+=/fury_of_elune
actions.opener_st+=/celestial_alignment,if=!buff.ca_inc.up
actions.opener_st+=/starfall,if=(spell_targets>1&(buff.touch_the_cosmos.react|astral_power>80))
actions.opener_st+=/starsurge,if=(buff.touch_the_cosmos.react|astral_power>80)
actions.opener_st+=/starfire
actions.opener_aoe=sunfire,if=dot.sunfire.refreshable
actions.opener_aoe+=/moonfire,if=spell_targets<99&dot.moonfire.refreshable
actions.opener_aoe+=/fury_of_elune
actions.opener_aoe+=/celestial_alignment,if=!buff.ca_inc.up
actions.opener_aoe+=/eclipse,if=buff.eclipse.down
actions.opener_aoe+=/starfall,if=(astral_power>50|buff.ascendant_stars.up)
actions.opener_aoe+=/starsurge,if=buff.starfall.up&buff.ascendant_stars.up
actions.opener_aoe+=/starfire,if=buff.ascendant_stars.up
