# Elemental Shaman M+ measurement profile for FerrazShamanEle.yaml.
#
# GEAR IS NOT THE USER'S. No character export was supplied, so this carries the
# gear from SimC's own MID2_Shaman_Elemental profile verbatim. Only the talent
# string is the user's. Anything measured here is a statement about the
# PRIORITY, not about their character.
#
# Talents verified by execution probe against simc 1210.01.5f3ee6d:
#   Farseer (call_of_the_ancestors). No Master of the Elements, no Tempest,
#   no Lightning Rod, no Earth Shock.
shaman="Ferraz_Shaman_Ele"
source=default
spec=elemental
level=90
race=tauren
role=spell
